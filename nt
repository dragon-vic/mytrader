#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

PYTHON_BIN="$HOME/miniconda/envs/nt/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
  echo "找不到 conda 环境 nt 的 python：$PYTHON_BIN" >&2
  exit 1
fi

cd "$PROJECT_DIR"

clear_screen() {
  clear > /dev/tty
}

read_key() {
  local key
  IFS= read -rsn1 key < /dev/tty

  case "$key" in
    "")
      echo "enter"
      ;;
    $'\x1b')
      IFS= read -rsn2 -t 0.1 key < /dev/tty || true
      case "$key" in
        "[A")
          echo "up"
          ;;
        "[B")
          echo "down"
          ;;
        *)
          echo ""
          ;;
      esac
      ;;
    *)
      echo ""
      ;;
  esac
}

choose() {
  local title="$1"
  shift
  local options=("$@")
  local selected=0
  local key
  local index

  if [ "${#options[@]}" -eq 0 ]; then
    echo "没有可选择项：$title" >&2
    exit 1
  fi

  while true; do
    clear_screen
    echo "$title" > /dev/tty
    echo > /dev/tty

    for index in "${!options[@]}"; do
      if [ "$index" -eq "$selected" ]; then
        printf "> %s\n" "${options[$index]}" > /dev/tty
      else
        printf "  %s\n" "${options[$index]}" > /dev/tty
      fi
    done

    key="$(read_key)"
    case "$key" in
      enter)
        printf "%s" "${options[$selected]}"
        return
        ;;
      up)
        selected=$(( (selected - 1 + ${#options[@]}) % ${#options[@]} ))
        ;;
      down)
        selected=$(( (selected + 1) % ${#options[@]} ))
        ;;
    esac
  done
}

config_names() {
  local file
  local name

  for file in config/*.yaml; do
    [ -e "$file" ] || continue
    name="$(basename "$file" .yaml)"
    if [ "$name" != "global" ]; then
      printf "%s\n" "$name"
    fi
  done | sort
}

running_options() {
  local configs=()
  local config
  local session

  command -v tmux >/dev/null 2>&1 || return 0
  mapfile -t configs < <(config_names)

  while IFS= read -r session; do
    for config in "${configs[@]}"; do
      if [ "$session" = "$config" ] || [[ "$session" == "$config"-* ]]; then
        printf "运行中：%s\n" "$session"
        break
      fi
    done
  done < <(tmux list-sessions -F "#{session_name}" 2>/dev/null | sort)
}

mode_value() {
  case "$1" in
    "模拟盘")
      echo "testnet"
      ;;
    "回测")
      echo "backtest"
      ;;
    "实盘")
      echo "live"
      ;;
    *)
      echo "未知模式：$1" >&2
      exit 1
      ;;
  esac
}

run_background() {
  local config_name="$1"
  local mode="$2"
  local session_name
  local tmux_command
  local log_dir
  local log_path
  local pid

  if ! command -v tmux >/dev/null 2>&1; then
    echo "后台运行需要 tmux，请先安装 tmux，或选择前台运行。" >&2
    exit 1
  fi

  session_name="${config_name}-$(date +%Y%m%d%H%M%S)"

  log_dir="$PROJECT_DIR/reports/tmux"
  log_path="$log_dir/$session_name.log"
  mkdir -p "$log_dir"

  printf -v tmux_command "%q -u run.py %q %q 2>&1 | tee %q" "$PYTHON_BIN" "$config_name" "$mode" "$log_path"
  tmux new-session -d -s "$session_name" -c "$PROJECT_DIR" "bash -lc '$tmux_command'"
  pid="$(tmux display-message -p -t "$session_name" "#{pane_pid}")"

  echo "后台进程已启动：$config_name $mode"
  echo "tmux会话：$session_name"
  echo "PID：$pid"
  echo "日志：$log_path"
  echo "重新打开：tmux attach -t $session_name"
  echo "临时退出：Ctrl+b 然后按 d"
  echo "停止运行：重新打开后按 Ctrl+C"
}

if [ "$#" -gt 0 ]; then
  exec "$PYTHON_BIN" run.py "$@"
fi

if [ ! -t 0 ]; then
  echo "交互模式需要真实终端；非终端环境请用 ./nt 配置名 模式" >&2
  exit 1
fi

mapfile -t CONFIGS < <(config_names)
mapfile -t RUNNING < <(running_options)
CONFIGS+=("${RUNNING[@]}")
CONFIG_NAME="$(choose "请选择配置：" "${CONFIGS[@]}")"

case "$CONFIG_NAME" in
  运行中：*)
    SESSION_NAME="${CONFIG_NAME#运行中：}"
    exec tmux attach -t "$SESSION_NAME"
    ;;
esac

MODE_LABEL="$(choose "请选择模式：" "模拟盘" "回测" "实盘")"
MODE="$(mode_value "$MODE_LABEL")"
RUN_STYLE="$(choose "请选择运行方式：" "前台运行" "后台运行")"

case "$RUN_STYLE" in
  "前台运行")
    exec "$PYTHON_BIN" run.py "$CONFIG_NAME" "$MODE"
    ;;
  "后台运行")
    run_background "$CONFIG_NAME" "$MODE"
    ;;
esac
