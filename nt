#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$HOME/mytrader"

PYTHON_BIN="$HOME/miniconda/envs/nt/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
  echo "找不到 conda 环境 nt 的 python：$PYTHON_BIN" >&2
  exit 1
fi

cd "$PROJECT_DIR"

clear_screen() {
  clear > /dev/tty
}

read_key() {
  local key
  IFS= read -rsn1 key < /dev/tty

  case "$key" in
    "")
      echo "enter"
      ;;
    $'\x1b')
      IFS= read -rsn2 -t 0.1 key < /dev/tty || true
      case "$key" in
        "[A")
          echo "up"
          ;;
        "[B")
          echo "down"
          ;;
        *)
          echo ""
          ;;
      esac
      ;;
    *)
      echo ""
      ;;
  esac
}

choose() {
  local title="$1"
  shift
  local options=("$@")
  local selected=0
  local key
  local index

  if [ "${#options[@]}" -eq 0 ]; then
    echo "没有可选择项：$title" >&2
    exit 1
  fi

  while true; do
    clear_screen
    echo "$title" > /dev/tty
    echo > /dev/tty

    for index in "${!options[@]}"; do
      if [ "$index" -eq "$selected" ]; then
        printf "> %s\n" "${options[$index]}" > /dev/tty
      else
        printf "  %s\n" "${options[$index]}" > /dev/tty
      fi
    done

    key="$(read_key)"
    case "$key" in
      enter)
        printf "%s" "${options[$selected]}"
        return
        ;;
      up)
        selected=$(( (selected - 1 + ${#options[@]}) % ${#options[@]} ))
        ;;
      down)
        selected=$(( (selected + 1) % ${#options[@]} ))
        ;;
    esac
  done
}

config_names() {
  local file
  local name

  for file in config/*.yaml; do
    [ -e "$file" ] || continue
    name="$(basename "$file" .yaml)"
    if [ "$name" != "global" ]; then
      printf "%s\n" "$name"
    fi
  done | sort
}

mode_value() {
  case "$1" in
    "模拟盘")
      echo "testnet"
      ;;
    "回测")
      echo "backtest"
      ;;
    "实盘")
      echo "live"
      ;;
    *)
      echo "未知模式：$1" >&2
      exit 1
      ;;
  esac
}

run_background() {
  local config_name="$1"
  local mode="$2"
  local running_log="logs/${config_name}-${mode}-running.log"
  local session_name="$config_name"
  local tmux_command
  local pid

  if ! command -v tmux >/dev/null 2>&1; then
    echo "后台运行需要 tmux，请先安装 tmux，或选择前台运行。" >&2
    exit 1
  fi

  mkdir -p logs
  if tmux has-session -t "$session_name" 2>/dev/null; then
    session_name="${session_name}-$(date +%Y%m%d%H%M%S)"
  fi

  printf -v tmux_command "exec %q run.py %q %q" "$PYTHON_BIN" "$config_name" "$mode"
  tmux new-session -d -s "$session_name" -c "$PROJECT_DIR" "$tmux_command"
  pid="$(tmux display-message -p -t "$session_name" "#{pane_pid}")"

  echo "后台进程已启动：$config_name $mode"
  echo "tmux会话：$session_name"
  echo "PID：$pid"
  if [ "$mode" != "backtest" ]; then
    echo "运行日志：$running_log"
  fi
  echo "重新打开：tmux attach -t $session_name"
  echo "临时退出：Ctrl+b 然后按 d"
  echo "停止运行：重新打开后按回车"
}

if [ "$#" -gt 0 ]; then
  exec "$PYTHON_BIN" run.py "$@"
fi

if [ ! -t 0 ]; then
  echo "交互模式需要真实终端；非终端环境请用 ./nt 配置名 模式" >&2
  exit 1
fi

mapfile -t CONFIGS < <(config_names)
CONFIG_NAME="$(choose "请选择配置：" "${CONFIGS[@]}")"
MODE_LABEL="$(choose "请选择模式：" "模拟盘" "回测" "实盘")"
MODE="$(mode_value "$MODE_LABEL")"
RUN_STYLE="$(choose "请选择运行方式：" "前台运行" "后台运行")"

case "$RUN_STYLE" in
  "前台运行")
    exec "$PYTHON_BIN" run.py "$CONFIG_NAME" "$MODE"
    ;;
  "后台运行")
    run_background "$CONFIG_NAME" "$MODE"
    ;;
esac
