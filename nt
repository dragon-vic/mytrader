#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$HOME/mytrader"

if [ -x "$HOME/miniconda3/envs/nt/bin/python" ]; then
  PYTHON_BIN="$HOME/miniconda3/envs/nt/bin/python"
elif [ -x "$HOME/anaconda3/envs/nt/bin/python" ]; then
  PYTHON_BIN="$HOME/anaconda3/envs/nt/bin/python"
else
  echo "找不到 conda 环境 nt 的 python，请确认环境位置" >&2
  exit 1
fi

cd "$PROJECT_DIR"
exec "$PYTHON_BIN" run.py "$@"