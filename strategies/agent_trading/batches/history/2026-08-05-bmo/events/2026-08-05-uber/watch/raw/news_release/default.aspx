            <script>
    var q4App = $.extend(true, q4Defaults, {
        options: {
            mailingListConfig: {
                tpl: (
                    /* beautify preserve:start */
                    '<div id="SubscriberConfirmation" class="module module-subscribe module-subscribe--fancy grid_col grid_col--1-of-1 grid_col--lc-1-of-1 grid_col--md-1-of-1">' +
                        '<div class="module_container--outer">' +
                            '<h2 class="module_title">Signup for email alerts</h2>' +
                            '<div class="module_container--inner">' +
                                '<p class="module_message module_message--success"></p>' +
                            '</div>' +
                        '</div>' +
                    '</div>'
                    /* beautify preserve:end */
                ),
                location: '.pane--footer'
            }
        },
        // toggle contrast function
        contrast: {
            toggle: '.module-contrast_button',
            getCookie: function() {
                return document.cookie.replace(/(?:(?:^|.*;\s*)contrast\s*\=\s*([^;]*).*$)|^.*$/, "$1");
            },
            setCookie: function(boolean) {
                document.cookie = 'contrast=' + boolean + '; path=/';
            },
            init: function() {
                var inst = this;
                if (!inst.getCookie().length) {
                    inst.setCookie('false');
                } else if (inst.getCookie() == 'true') {
                    $(inst.toggle).addClass('js--active');
                    $('body').addClass('js--contrast');
                }
    
                $(inst.toggle).on('click', function(e) {
                    e.preventDefault();
                    if (inst.getCookie() == 'false') {
                        inst.setCookie('true');
                    } else {
                        inst.setCookie('false');
                    }
                    $(this).toggleClass('js--active');
                    $('body').toggleClass('js--contrast');
                });
            }
        },
        tabs: function($container, trigger, content, select, useHash) {
            var hash = window.location.hash.split('#')[1],
                hashTargetExists = $(content + '.' + hash).length > 0,
                changeHash = useHash != undefined ? useHash : true,
                first,
                $hiddenContent = function() {
                    return $container.find(content).addClass('js--hidden').attr('aria-hidden', 'true');
                };
    
            if (hash && hashTargetExists) {
                $hiddenContent().filter('.' + hash).removeClass('js--hidden').attr('aria-hidden', 'false');
                if (trigger) $container.find(trigger).attr('tabindex', '0').filter('[data-tab=".' + hash + '"]').addClass('js--selected');
                if (select) $(select + ' option[value=".' + hash + '"]').attr('selected', true);
            } else {
                $hiddenContent();
            }
    
            // if trigger is used/defined
            if (trigger) {
                first = $container.find(trigger).first().data('tab');
    
                if (!hash || !hashTargetExists) {
                    $container.find(trigger).attr('tabindex', '0').first().addClass('js--selected');
                    $container.find(first).removeClass('js--hidden').attr('aria-hidden', 'false');
                    // change hash on load
                    if (changeHash) window.location.hash = first.split('.')[1];
                }
    
                $container.on('click keypress', trigger, function(e) {
                    var $this = $(this),
                        tabPosition = $this.position().left,
                        tabWidth = $this.outerWidth(),
                        containerScroll = $this.closest('.module_tabs').scrollLeft(),
                        containerWidth = $this.closest('.module_tabs').outerWidth();

                    // scroll container if tab text not fully visible
                    if ( tabPosition < 0 || tabPosition + tabWidth > containerWidth - 40 ) {
                        $(this).closest('.module_tabs').animate({
                            scrollLeft: tabPosition+containerScroll
                        });
                    }

                    if (changeHash) window.location.hash = $(this).data('tab').split('.')[1];
                    if ($container.trigger(trigger).is('a, button')) e.preventDefault();
                    $(this).addClass('js--selected').parent().find('.js--selected').not(this).removeClass('js--selected');
                    $hiddenContent().filter($(this).data('tab')).removeClass('js--hidden').attr('aria-hidden', 'false');
                    // update select
                    if (select) {
                        $(select).val($(this).data('tab'));
                    }
                });
            }
    
            // if select is used/defined
            if (select) {
                first = $(select + ' option:first-child').val();
    
                if (!hash || !hashTargetExists) {
                    $(select + ' option:first-child').attr('selected', true);
                    $(first).removeClass('js--hidden').attr('aria-hidden', 'false');
                    // change hash on load
                    if (changeHash) window.location.hash = first.split('.')[1];
                }
    
                $container.on('change', select, function(e) {
                    var tab = $(this).val();
                    if (changeHash) window.location.hash = $(this).val().split('.')[1];
                    $hiddenContent().filter(tab).removeClass('js--hidden').attr('aria-hidden', 'false');
                    if (trigger) $container.find(trigger).removeClass('js--selected').filter('[data-tab="' + tab + '"]').addClass('js--selected');
                });
            }
        },
        sections: function() {
            $('.module-section').hide();
            $('.module-section').first().show().addClass('js--show');
            var hash = decodeURIComponent(window.location.hash.length ? window.location.hash.substring(1) : '');
            if ($('.module-' + hash).length) {
                $('.module-section').hide().removeClass('js--show');
                $('.module-' + hash).show().addClass('js--show');
            }
            $('.nav--secondary').find('li.selected .level2 >li:first-child').addClass('js--selected');
            $(".nav--secondary .level2 li a").each(function() {
                var hashLink = $(this).attr('href').split('#')[1];
                if (hash.length) { 
                    if(hash === hashLink) {
                        $(this).parent().addClass('js--selected').siblings().removeClass('js--selected');
                    }
                }
            });
            $('nav').on('click', 'a[href*="#"]', function(e) {
                $(this).parent().addClass('js--selected').siblings().removeClass('js--selected');
                var $parent = $(this).closest('ul').parent('li'),
                    hash = $(this).attr('href').split('#')[1];
                if ($parent.hasClass('selected')) {
                    e.preventDefault();
                    $('.module-section').hide()
                    $('.module-' + hash).show().addClass('js--show');
                }
            });

            $('.nav--secondary .level2').on('click keypress', '> li >a', function(e) {
                    var $this = $(this),
                        tabPosition = $this.position().left,
                        tabWidth = $this.outerWidth(),
                        containerScroll = $this.closest('.level1').scrollLeft(),
                        containerWidth = $this.closest('.level1').outerWidth();

                    // scroll container if tab text not fully visible
                    if ( tabPosition < 0 || tabPosition + tabWidth > containerWidth - 40) {
                        $(this).closest('.level1').animate({
                            scrollLeft: tabPosition+containerScroll - 36
                        });
                    }
            });
        },
        searchToggle: function() {
            $('.layout_toggle-search--button').on('click', function() {
                $('.layout').toggleClass('js--search');
            });
        },
        arrowsFunctionality: function($nav) {
            var scrolled = 0;
            $nav.on("click", '.right-arrow', function() {
                scrolled = scrolled + 50;
                $nav.animate({
                    scrollLeft: scrolled
                });
            });
            $nav.on("click", '.left-arrow', function() {
                scrolled = scrolled - 50;
                $nav.animate({
                    scrollLeft: scrolled
                });
            });
        },
        scrollArrowsFunction: function($container, $scroll_container) {
            $container.addClass('js--right-active');
            $scroll_container.on("scroll", function() {
                var currentScroll = $(this).scrollLeft();
                if (currentScroll == 0) {
                    $container.addClass('js--arrow-right').removeClass('js--arrow-left');
                } else {
                    var maxScroll = $(this)[0].scrollWidth - $scroll_container.width();
                    if (currentScroll == maxScroll) {
                        $container.addClass('js--arrow-left').removeClass('js--arrow-right js--right-active');
                    } else {
                        $container.addClass('js--arrow-right js--arrow-left');
                    }
                }
            });
        },
        fadeEffect: function(a) {
            var windowHeight = $(window).height();
    
            $(a).each(function() {
                var top_of_object = $(this).offset().top;
    
                if (windowHeight > top_of_object) {
                    $(this).addClass('js--fade-out');
                }
            });
    
            $(window).on('scroll', function() {
                var bottom_of_window = $(window).scrollTop() + $(window).height();
    
                $(a).each(function() {
                    var top_of_object = $(this).offset().top;
    
                    if ($(this).css('display') !== 'none') {
                        if (bottom_of_window > top_of_object) {
                            $(this).addClass('js--fade-out');
                        }
                    }
                });
            });
        },
        animateValue: function(elem, start, end, durHigh, durLow, complete) {
            // var inst = this;
            elem.animate({ strokeDashoffset: end }, {
                duration: durHigh,
                easing: 'linear',
                complete: function() {
                    elem.css({ strokeDashoffset: start });
                    if (complete !== undefined && typeof(complete) === 'function') {
                        complete();
                    }
                    q4App.animateValue(elem, start, end, durHigh, durLow, complete);
                }
            });
        },
        arrowsAppend: function() {
            $('.nav--secondary .level2').append('<span class="left-arrow"><i class="q4-icon_chevron-left"></i></span><span class="right-arrow"><i class="q4-icon_chevron-right"></i></span>');
        },
        scollingTable: function(selector){
            $(selector).not(selector+' table').wrap('<div class="table-wrapper" />');
        },
        toggle: function($container, item, toggle, panel, accordion, allButton, openFirst) {
            var $this = this,
                $item = $container.find(item);

            $this.accessibilize($container, $container.find(item).find(toggle), $container.find(item).find(panel));
            
            $item.on('click keypress', toggle, function(e) {
                e.preventDefault();
                if (e.which == 13 || e.type == 'click') {
                    if (accordion) {
                        // allow item to be closed in accordion mode
                        if ( $(this).attr('aria-expanded') == 'true' ) {
                            $this._toggleTrigger($(this), $container, item, panel);
                        } else {
                            $this._accordionTrigger($(this), $container, item, toggle, panel);
                        }
                    } else {
                        $this._toggleTrigger($(this), $container, item, panel);
                    }

                    if (allButton) {
                        if (!$container.find(item + '.js--active').length) {
                            $container.find('.toggle-all').removeClass('js--active');
                        }
                        if ($container.find(item + '.js--active').length === $container.find(item).length) {
                            $container.find('.toggle-all').addClass('js--active');
                        }
                    }
                }
            });

            if (allButton) {
                $this._toggleAll($container, item, toggle, panel);
            }

            if (openFirst) {
                $item.first().find(toggle).attr('aria-expanded', true);
                $item.first().addClass('js--active').find(panel).removeClass('js--hidden');
            }
        },
        navAriaLabel: function(){
            var tabLengthNav = $('.nav--secondary li.selected > .level2 > li').length;
            console.log(tabLengthNav);
            $('.nav--secondary li.selected > .level2 > li').each(function(i ,el){
                var elem = $(this).find('>a');
                var text = elem.text();
                var index = i + 1;
                elem.attr('aria-label', text + " Tab " + index +" of "+ tabLengthNav);
            });
            var tabLength = $('.module-news-and-events .module_tabs-inner > h6').length;
            var tabLength2 = $('.module-citizenship .module_tabs-inner > h6').length;
            //console.log(tabLength);
            $('.module-news-and-events .module_tabs-inner > h6').each(function(i, el){
                var elem = $(this).find('>span');
                var text = elem.text();
                var index = i + 1;
                elem.attr('aria-label', text + " Tab " + index +" of "+ tabLength);
            });
            $('.module-citizenship .module_tabs-inner > h6').each(function(i, el){
                var elem = $(this).find('>span');
                var text = elem.text();
                var index = i + 1;
                elem.attr('aria-label', text + " Tab " + index +" of "+ tabLength2);
            });
            $('.nav--secondary .level1 > li.selected .level2').attr('role','tablist').find('> li > a').attr('role','tab');
            $('.module-subscribe--fancy .module-subscribe_form input[type="text"]').each(function(){
                $(this).attr('aria-label',$(this).attr('placeholder'));
            });
        },  
        clientDocTracking: function(){
            $('.pane--footer2 a, .pane--credits a').not('a[href*="mailto"]').on('click', function() {
                var linkText = $(this).text();
                window.ga("Client.send", "event", 'investor-footer_uber', 'click', linkText)
                // window.ga('Client.send', {
                //     eventCategory: 'investor-footer_uber',
                //     eventAction: 'click',
                //     eventLabel: linkText
                // });
            });
            $('a[href*="mailto"]').on('click', function() {
                window.ga("Client.send", "event", 'investor_uber', 'click', 'contact-us')
                // window.ga('Client.send', {
                //     eventCategory: 'investor_uber',
                //     eventAction: 'click',
                //     eventLabel: 'contact-us'
                // });
            });
            $('a[href$=".pdf"],a[href$=".doc"],a[href$=".rtf"],a[href$=".zip"],a[href$=".exe"],a[href$=".xls"],a[href$=".ppt"],a[href$=".txt"],a[href$=".rar"]').on('click', function() {
                window.ga("Client.send", "event", 'investor_uber', 'click', 'download')
                // window.ga('Client.send', {
                //     eventCategory: 'investor_uber',
                //     eventAction: 'click',
                //     eventLabel: 'download'
                // });
            });
        },
        init: function() {
            var app = this;
    
            app.cleanUp();
            app.submitOnEnter('.module-unsubscribe');
            app.submitOnEnter('.module-search');
            app.validateSubmit('.module-search');
            app.mobileMenuToggle($('.layout'), '.nav--main', '.layout_toggle i');
            app.cleanQuickLinks($('.module-links'));
            app.copyright($('.copyright_year'));
            app.reveal('.pane--footer .module-subscribe', '.module-subscribe_email', '.module-subscribe_mailing-list, .module_actions', true);
            //app.docTracking(); requested by client to remove.
            app.fancySignup();
            app.resetDate(['.nav a[href*="s3.q4web.com"]:not([href$=".pdf"])']);
            app.previewToolbar();
            app.sections();
            app.searchToggle();
            // app.contrast.init();
            app.arrowsAppend();
            app.arrowsFunctionality($('.nav--secondary .level1'));
            app.scrollArrowsFunction($('.nav--secondary .level1 > li.has-children'), $('.nav--secondary .level1'));
            app.arrowsFunctionality($('.module_tabs'));
            app.scrollArrowsFunction($('.module_tabs-inner'), $('.module_tabs'));
            app.fadeEffect($('.pane--content .module'));
            app.fadeEffect($('.pane--banner .module'));
            app.navAriaLabel();
            app.clientDocTracking();
        }
    });
    
    q4App.init();
    </script>
