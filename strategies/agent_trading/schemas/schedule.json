{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "session", "watch_start_at", "watch_end_at", "events"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "session": {"type": "string", "enum": ["BMO", "AMC"]},
    "watch_start_at": {"type": "string", "format": "date-time"},
    "watch_end_at": {"type": "string", "format": "date-time"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "company", "ticker", "expected_at", "relevance_reason"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "company": {"type": "string", "minLength": 1},
          "ticker": {"type": "string", "minLength": 1},
          "expected_at": {"type": "string", "format": "date-time"},
          "relevance_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
