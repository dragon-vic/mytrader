{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "directionalOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "expected_move_pct"],
      "properties": {
        "condition": {"type": "string", "minLength": 1},
        "expected_move_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    },
    "holdOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition"],
      "properties": {
        "condition": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "as_of",
    "research_complete",
    "research_report",
    "analysis_brief",
    "trade_candidates",
    "sources"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "research_complete": {"type": "boolean"},
    "research_report": {"type": "string", "minLength": 1},
    "analysis_brief": {"type": "string", "minLength": 1},
    "trade_candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "instrument_id", "outcomes"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "instrument_id": {"type": "string", "minLength": 1},
          "outcomes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "STRONG_BUY",
              "MEDIUM_BUY",
              "WEAK_BUY",
              "HOLD",
              "WEAK_SELL",
              "MEDIUM_SELL",
              "STRONG_SELL"
            ],
            "properties": {
              "STRONG_BUY": {"$ref": "#/$defs/directionalOutcome"},
              "MEDIUM_BUY": {"$ref": "#/$defs/directionalOutcome"},
              "WEAK_BUY": {"$ref": "#/$defs/directionalOutcome"},
              "HOLD": {"$ref": "#/$defs/holdOutcome"},
              "WEAK_SELL": {"$ref": "#/$defs/directionalOutcome"},
              "MEDIUM_SELL": {"$ref": "#/$defs/directionalOutcome"},
              "STRONG_SELL": {"$ref": "#/$defs/directionalOutcome"}
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "published_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "published_at": {"type": ["string", "null"]}
        }
      }
    }
  }
}
