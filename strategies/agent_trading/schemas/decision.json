{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "version",
    "event_id",
    "decision",
    "trades",
    "summary",
    "applied_rules",
    "rule_deviations"
  ],
  "properties": {
    "type": {"const": "trade_decision"},
    "version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["TRADE", "HOLD"]},
    "trades": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument_id", "side", "confidence", "rule_ids"],
        "properties": {
          "instrument_id": {"type": "string", "minLength": 1},
          "side": {"type": "string", "enum": ["BUY", "SELL"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rule_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "applied_rules": {"type": "array", "items": {"type": "string"}},
    "rule_deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "new_fact", "reason", "confidence_impact"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "new_fact": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "confidence_impact": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
