{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "event_id", "decision", "trades", "summary"],
  "properties": {
    "type": {"type": "string", "const": "trade_decision"},
    "version": {"type": "integer", "const": 3},
    "event_id": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["TRADE", "HOLD"]},
    "trades": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument_id",
          "signal",
          "expected_move_pct",
          "confidence"
        ],
        "properties": {
          "instrument_id": {"type": "string", "minLength": 1},
          "signal": {
            "type": "string",
            "enum": [
              "STRONG_BUY",
              "MEDIUM_BUY",
              "WEAK_BUY",
              "WEAK_SELL",
              "MEDIUM_SELL",
              "STRONG_SELL"
            ]
          },
          "expected_move_pct": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1}
  }
}
